DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# File storage for step photos and clips: a private Cloudflare R2 bucket (any S3-compatible store works).
# Server-only: never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="recipe-media"
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# File storage for step photos and clips: a private Cloudflare R2 bucket (any S3-compatible store works).
# Server-only: never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="recipe-media"
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# Secret address of the admin sign-in page: https://<site>/<ADMIN_LOGIN_PATH>. 20–64 characters of
# A–Z, a–z, 0–9, "-" or "_". Without a valid value there is no admin sign-in page. Read at build time,
# so a change needs a new deploy.
ADMIN_LOGIN_PATH=""

# Email for password-reset and email-change codes. Server-only. Without EMAIL_PROVIDER, emails are printed
# to the dev server console in development and sending fails closed in production.
# Any SMTP sender works, e.g. Gmail: SMTP_HOST="smtp.gmail.com", SMTP_USER=<the Gmail address>,
# SMTP_PASSWORD=<an app password from myaccount.google.com/apppasswords>.
EMAIL_PROVIDER="smtp"
SMTP_HOST=""
# 465 = TLS from the start; 587 = STARTTLS.
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional: defaults to "Retseplar <SMTP_USER>".
EMAIL_FROM=""
# Cost guard: most emails the whole site may send per day.
EMAIL_DAILY_LIMIT="400"

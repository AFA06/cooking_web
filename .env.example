DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# File storage for step photos and clips: a private Cloudflare R2 bucket (any S3-compatible store works).
# Server-only: never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="recipe-media"
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=""

# SMS codes for signup and password recovery. Server-only. Without SMS_PROVIDER, codes are printed to the
# dev server console in development and sending fails closed in production.
# Codes go out through DevSMS' pre-approved universal OTP templates (devsms.uz → API kalitlari).
SMS_PROVIDER="devsms"
# Signup skips the SMS/email code unless this is "on".
SIGNUP_VERIFICATION="on"
DEVSMS_API_KEY=""
# Name shown in the code SMS ("... code for <name>"). DevSMS moderates it; defaults to the site name.
DEVSMS_SERVICE_NAME=""
# Cost guard: most SMS the whole site may send per day.
SMS_DAILY_LIMIT="1000"
